*,*:before,*:after{box-sizing:border-box}body,#app{margin:0;padding:0}uni-app{display:block;max-width:480px;width:100%;margin-left:auto!important;margin-right:auto!important}:root{--bg: oklch(17% .012 70);--bg-deep: oklch(13.5% .011 70);--surface: oklch(22% .014 70);--surface-2: oklch(26.5% .016 70);--raised: oklch(31% .018 70);--fg: oklch(95% .008 70);--fg-soft: oklch(88% .01 70);--muted: oklch(67% .012 70);--faint: oklch(56% .012 70);--border: oklch(31% .015 70);--border-strong: oklch(42% .02 70);--accent: oklch(81% .13 84);--accent-strong: oklch(71% .15 74);--accent-soft: oklch(81% .13 84 / .14);--danger: oklch(64% .19 26);--success: oklch(74% .14 152);--info: oklch(72% .11 235);--t-amber: oklch(78% .13 80);--t-violet: oklch(72% .12 295);--t-gold: oklch(82% .13 95);--t-teal: oklch(74% .1 195);--t-emerald: oklch(74% .13 158);--t-rose: oklch(72% .12 15);--font-display: "Cinzel", "Noto Serif SC", "Songti SC", serif;--font-serif: "Noto Serif SC", "Songti SC", "SimSun", serif;--font-body: "Noto Sans SC", -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;--font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace}page{background-color:var(--bg-deep);color:var(--fg);font-family:var(--font-body);-webkit-font-smoothing:antialiased}html{background:#030201;scrollbar-width:none;-ms-overflow-style:none}body{background:#030201;overflow-x:hidden;scrollbar-width:none;-ms-overflow-style:none}::-webkit-scrollbar{width:0;height:0}uni-app{background-color:var(--bg-deep);min-height:100vh}#app:before{content:"";position:fixed;top:0;left:50%;width:480px;max-width:100%;height:100%;transform:translate(-50%);box-shadow:inset 1px 0 #f3c443,inset -1px 0 #f3c443;pointer-events:none;z-index:99999}.nav-bar-fixed,.custom-navbar,.input-container,.inventory-modal,.status-modal,.fate-panel,.dice-animation,.edit-mask,.modal,.teaser{max-width:480px;margin:0 auto}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}